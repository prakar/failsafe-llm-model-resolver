# Optional – only needed for live smoke tests / production use
XAI_API_KEY=
# or GROK_API_KEY=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Pinned fallbacks: used ONLY when live resolution fails. Set these to IDs you have
# confirmed work for YOUR account - the built-in defaults are reviewed but not
# tested against your keys (and pins go stale: see README).
# XAI_MODEL_FALLBACK=grok-4
# ANTHROPIC_MODEL_FALLBACK=claude-sonnet-5
# GEMINI_MODEL_FALLBACK=gemini-flash-latest
# OPENROUTER_MODEL_FALLBACK=openrouter/free

# Per-request timeout for /models calls, in milliseconds (default 10000)
# LLM_MODEL_RESOLVER_TIMEOUT_MS=10000
