{
  "name": "llm-model-resolver",
  "version": "1.4.0",
  "description": "Resolve the current model ID for xAI, Anthropic, Gemini and OpenRouter at runtime. Config-file-driven: include/exclude patterns, pins, and fallbacks live in YAML/JSON, not in code.",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "node --test test/resolver.test.js && node smoke-test.js",
    "smoke": "node smoke-test.js",
    "inspect": "node inspect.js",
    "build-profiles": "node build-profiles.js",
    "prepare": "node build-profiles.js"
  },
  "keywords": [
    "llm",
    "model",
    "resolver",
    "grok",
    "claude",
    "gemini",
    "openrouter",
    "config"
  ],
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "profiles/",
    "README.md",
    "CHANGELOG.md",
    "build-profiles.js"
  ],
  "devDependencies": {
    "js-yaml": "^4.1.0"
  }
}
